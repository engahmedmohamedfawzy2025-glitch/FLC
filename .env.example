# ─────────────────────────────────────────────────────────
# Environment Variables for TechNova CMS
# ─────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your values.
# Never commit `.env.local` or `.env` to git.

# ── PUBLIC (safe to expose to the browser) ──
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://dqpriqcxnfkmnqzjwrad.supabase.co

# Supabase anon key (public read access, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Hrq8YRHVq4WoF11AQ7yYOw_xhEzHh1V

# ── SECRET (NEVER expose to the browser) ──
# Supabase service role key — server-side only
# Used by the user-management edge function for auth admin operations
# DO NOT prefix with NEXT_PUBLIC_
# This is auto-configured in the Supabase Edge Function environment
# You do NOT need to add this to Vercel — it's already available to edge functions
SUPABASE_SERVICE_ROLE_KEY=sb_secret_q2cOsMlNwqSJo9_eVuirpg_pswO6Ngp

# ── Notes ──
# - NEXT_PUBLIC_ variables are bundled into the browser JS
# - Variables WITHOUT NEXT_PUBLIC_ are only available server-side
# - The service role key bypasses RLS — never import it in client components
# - The user-management edge function uses the service role key server-side
#   to create/delete users and reset passwords. The browser calls the edge
#   function, which verifies the caller is a super_admin before acting.
